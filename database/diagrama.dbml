Table clientes {
  cliente_id int [pk, increment]
  nombre varchar(100)
  correo varchar(100) [unique]
  estado enum
  limite_credito decimal(10,2)
}

Table direcciones {
  direccion_id int [pk, increment]
  cliente_id int
  calle varchar(150)
  ciudad varchar(100)
  codigo_postal varchar(10)
  tipo enum
}

Table almacenes {
  almacen_id int [pk, increment]
  nombre varchar(100)
  ubicacion varchar(200)
  capacidad_maxima int
}

Table envios {
  envio_id int [pk, increment]
  remitente_id int
  destinatario_id int
  direccion_origen_id int
  direccion_destino_id int
  costo_total decimal(10,2)
  fecha datetime
  estado_global enum
}

Table paquetes {
  paquete_id int [pk, increment]
  envio_id int
  almacen_id int
  peso decimal(8,2)
  dimensiones varchar(50)
  contenido varchar(255)
}

Table historial_rastreo {
  rastreo_id int [pk, increment]
  envio_id int
  fecha datetime
  ubicacion_actual varchar(150)
  estado_evento enum
  observaciones text
}

Table auditoria_envios {
  auditoria_id int [pk, increment]
  envio_id int
  costo_anterior decimal(10,2)
  costo_nuevo decimal(10,2)
  usuario varchar(100)
  fecha_modificacion datetime
}

Ref: direcciones.cliente_id > clientes.cliente_id
Ref: envios.remitente_id > clientes.cliente_id
Ref: envios.destinatario_id > clientes.cliente_id
Ref: envios.direccion_origen_id > direcciones.direccion_id
Ref: envios.direccion_destino_id > direcciones.direccion_id
Ref: paquetes.envio_id > envios.envio_id
Ref: paquetes.almacen_id > almacenes.almacen_id
Ref: historial_rastreo.envio_id > envios.envio_id
Ref: auditoria_envios.envio_id > envios.envio_id
